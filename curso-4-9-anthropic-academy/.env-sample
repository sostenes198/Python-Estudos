# Copie este arquivo para .env e preencha com sua chave real:
#   cp .env-sample .env
#
# Gere sua chave em: https://console.anthropic.com/settings/keys
# O SDK da Anthropic lê esta variável automaticamente em Anthropic().
ANTHROPIC_API_KEY=sk-ant-...

# Gere sua chave em: https://dashboard.voyageai.com/api-keys
# O SDK da VoyageAI lê esta variável automaticamente em voyageai.Client().
VOYAGE_API_KEY=pa-...

# Modelo usado pelo chat MCP (4-mcp/main.py)
CLAUDE_MODEL=claude-sonnet-4-5
